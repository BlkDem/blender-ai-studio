# Where the studio keeps its database, secrets and settings.
# STUDIO_DATA_DIR=/home/you/.local/share/blender-ai-studio

# --- Blender (the MCP server this studio drives) --------------------------
# Point these at your blender-mcp checkout. The studio never writes there.
STUDIO_BLENDER_MCP_PATH=/path/to/blender-mcp
STUDIO_BLENDER_MCP_PYTHON=/path/to/blender-mcp/.venv/bin/python

# How the MCP server is launched as a child process, if you add it by hand
# instead of through the GUI.
# STUDIO_MCP_SERVERS='[{"name":"Blender MCP","command":"/usr/bin/python3.11","args":["-m","server.main"],"cwd":"/path/to/blender-mcp","env":{"PYTHONPATH":"/path/to/blender-mcp"},"blender_port":8765}]'

# --- LLMs ------------------------------------------------------------------
# Keys can also be entered in the GUI and kept in the system keyring; these are
# the fallbacks for headless runs. Never put a key in a project file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# A gateway, a local vLLM, an OpenAI-compatible server of any kind:
# STUDIO_LLM_PROVIDERS='[{"name":"space-bunny","kind":"openai-compatible","base_url":"https://gateway.example/v1","default_model":"space-bunny-free","models":[{"id":"space-bunny-free","supports_tools":true,"input_price":0,"output_price":0}]}]'

# --- 3D generation ---------------------------------------------------------
# STUDIO_THREE_D__PROVIDER=tripo
# STUDIO_THREE_D__MODEL=v3.1-20260211

# --- Behaviour -------------------------------------------------------------
STUDIO_LOG_LEVEL=INFO
# STUDIO_AGENT__MAX_STEPS=30
# STUDIO_AGENT__MAX_TOOL_CALLS=50
# STUDIO_AGENT__ALLOW_EXECUTE_PYTHON=false
